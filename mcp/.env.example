# Penpot MCP Server Environment Configuration
# Copy this file to .env and customize the values as needed

# =============================================================================
# Server Configuration
# =============================================================================

# Host address on which the MCP server listens (binds to)
# Use 0.0.0.0 to bind to all interfaces (required for Docker)
PENPOT_MCP_SERVER_HOST=0.0.0.0

# Port for the HTTP/SSE server (MCP client connections)
PENPOT_MCP_SERVER_PORT=4401

# Port for the WebSocket server (plugin connections)
PENPOT_MCP_WEBSOCKET_PORT=4402

# Port for the REPL server (development/debugging)
PENPOT_MCP_REPL_PORT=4403

# Enable remote mode (disables file system access)
# Set to true when deploying remotely
PENPOT_MCP_REMOTE_MODE=false

# =============================================================================
# Plugin Configuration
# =============================================================================

# WebSocket URI that the plugin uses to connect to the MCP server
# This should be the public URL where the WebSocket server is accessible
# Format: ws://hostname:port or http://hostname:port
# For local development: http://localhost:4402
# For remote access: use your public IP or domain with ws:// protocol
WS_URI=ws://penpot-mcp:4402

# Enable multi-user mode (requires user tokens for authentication)
MULTI_USER_MODE=false

# =============================================================================
# Plugin Web Server Configuration
# =============================================================================

# Port on which the plugin web server listens
# This serves the plugin files to Penpot
PLUGIN_PORT=4400

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: trace, debug, info, warn, error
PENPOT_MCP_LOG_LEVEL=info

# Directory for log files (relative to container or absolute)
PENPOT_MCP_LOG_DIR=logs

# =============================================================================
# Example Configurations
# =============================================================================

# For local development:
# PENPOT_MCP_SERVER_HOST=0.0.0.0
# WS_URI=ws://penpot-mcp:4402
# PENPOT_MCP_REMOTE_MODE=false

# For remote deployment:
# PENPOT_MCP_SERVER_HOST=0.0.0.0
# WS_URI=ws://your-domain.com:4402
# PENPOT_MCP_REMOTE_MODE=true

# For multi-user mode:
# MULTI_USER_MODE=true
# PENPOT_MCP_REMOTE_MODE=true
